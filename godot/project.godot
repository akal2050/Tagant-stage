; Engine configuration file.
; iPad edition of the TAGANT assembly (from tagant-00). Same scene, plus the iPad bridge.

config_version=5

[application]

config/name="Tagant Stage"
run/main_scene="res://dove_man/assembly/dove_man_assembly.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://ipad/launch_black.png"

[audio]

driver/enable_input=true
general/ios/session_category=2

[autoload]

IpadBridge="*res://ipad/ipad_bridge.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=6

[display]

window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
