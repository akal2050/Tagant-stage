; TAGANT - Animal Karaoke (Godot 4.7, Android-ready)
config_version=5

[application]

config/name="TAGANT"
config/description="Karaoke, rehearsal and call-and-response with the synthesised animals of TAGANT"
run/main_scene="res://start/start.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.01, 0.01, 1)
boot_splash/show_image=false
boot_splash/image="res://start/launch_dark.png"

[audio]

driver/enable_input=true
general/ios/session_category=2

[autoload]

Lex="*res://start/lex.gd"
Worlds="*res://start/worlds.gd"
Remote="*res://start/remote.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
mesh_lod/lod_change/threshold_pixels=2.0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[shader_globals]

cine={
"type": "float",
"value": 0.0
}
bloom={
"type": "float",
"value": 0.0
}
film_clock={
"type": "float",
"value": 0.0
}
