; Engine configuration file.
; iPad edition of the TAGANT assembly (from tagant-00). Same scene, plus the iPad bridge.

config_version=5

[application]

config/name="Tagant Stage"
run/main_scene="res://dove_man/assembly/dove_man_assembly.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[audio]

driver/enable_input=true
general/ios/session_category=2

[autoload]

IpadBridge="*res://ipad/ipad_bridge.gd"

[display]

window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
